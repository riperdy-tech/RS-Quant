# ==============================================================================
# QuantDesk AI Trading System - Environment Configuration
# ==============================================================================

# Active AI Research Provider for Tier 3 Autonomous Researcher
# Options: 'deepseek', 'gemini', or 'offline'
AI_RESEARCH_PROVIDER=offline

# DeepSeek Configuration (v3 / v4.1 / Flash / Reasoner)
# Obtain your API key from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash


# Google Gemini Configuration (1.5 Flash / 2.0 Flash / Pro)
# Obtain your API key from: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Exchange Venue Execution (Defaults to DEMO paper-trading per safety rules)
QUANTDESK_ENVIRONMENT=DEMO
